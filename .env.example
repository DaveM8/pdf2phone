# Copy to .env and fill in:  cp .env.example .env && nano .env

# Your email address: it's your admin login.
PDF2PHONE_ADMIN_EMAIL=you@example.com

# Password for your FIRST login only (at least 12 characters). Straight after
# logging in you choose your own password, and this one stops working; you can
# then delete this line. A few random words (e.g. "harbour pencil violet gravy")
# is strong and easy to type on a phone.
PDF2PHONE_PASSWORD=change-me-to-something-long

# Long random string that signs the login cookie. Make one with:
#   python3 -c 'import secrets; print(secrets.token_hex(32))'
# Changing it logs out every device of every user.
PDF2PHONE_SECRET=

# Another long random string, made the same way as the secret. It keys the
# one-way code kept when someone deletes their account. Keep it: if it's lost,
# old deletion records can no longer be checked against an email address.
PDF2PHONE_RECORD_KEY=

# Biggest PDF you can upload, in MB (keep in step with client_max_body_size in nginx).
PDF2PHONE_MAX_MB=100

# Converter pre-selected on the upload form: pymupdf (fast), docling, docling-math.
PDF2PHONE_DEFAULT_ENGINE=pymupdf

# How many PDFs can be converted at the same time (1-8). Each careful (Docling)
# conversion needs about 4 GB of memory, so keep PDF2PHONE_MEM_LIMIT at about
# 4 GB per worker plus 2 GB. People take turns, so one person's pile of
# uploads doesn't hold everyone else up.
PDF2PHONE_WORKERS=3
PDF2PHONE_MEM_LIMIT=14g

# Port on 127.0.0.1 that nginx forwards to. Change it if 8090 is already used.
PDF2PHONE_PORT=8090

# ---- Email, for sign-up (optional). Leave these commented out and sign-up stays
# closed. To open it, fill in ALL of them (any SMTP service; these are Brevo's).
# The SMTP password is a key from the service: it lets anyone send email as your
# domain, so it only ever goes in .env, never in git.
# PDF2PHONE_SMTP_HOST=smtp-relay.brevo.com
# PDF2PHONE_SMTP_PORT=587
# PDF2PHONE_SMTP_USER=the-login-shown-on-brevos-smtp-page
# PDF2PHONE_SMTP_PASSWORD=the-smtp-key
# PDF2PHONE_MAIL_FROM=pdf2phone <noreply@yourdomain.com>
#
# The app's public address. Links in emails are built from this (https only).
# PDF2PHONE_PUBLIC_URL=https://read.yourdomain.com

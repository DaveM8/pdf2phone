# Copy to .env and fill in:  cp .env.example .env && nano .env

# The password you log in with (at least 8 characters).
PDF2PHONE_PASSWORD=change-me-to-something-long

# Long random string that signs the login cookie. Make one with:
#   python3 -c 'import secrets; print(secrets.token_hex(32))'
# Changing it (or the password) logs out every device.
PDF2PHONE_SECRET=

# Biggest PDF you can upload, in MB (keep in step with client_max_body_size in nginx).
PDF2PHONE_MAX_MB=100

# Converter pre-selected on the upload form: pymupdf (fast), docling, docling-math.
PDF2PHONE_DEFAULT_ENGINE=pymupdf

# Port on 127.0.0.1 that nginx forwards to. Change it if 8090 is already used.
PDF2PHONE_PORT=8090

<!doctype html>
<html lang="en" data-theme="cream" data-font="dyslexic">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<title>Account · Reader</title>
<link rel="stylesheet" href="/{{ static }}/reader.css">
<style>
  main { max-width: 520px; margin: 0 auto; padding-top: 20px; font-size: 22px; }
  h1 { font-size: 30px; margin: 0 0 6px; }
  .who { color: var(--muted); margin: 0 0 20px; overflow-wrap: anywhere; }
  .back { display: inline-block; margin-bottom: 14px; color: var(--link); font-size: 18px; }
  label { display: block; margin: 14px 0 8px; }
  input[type=password] { width: 100%; min-height: 56px; font: 22px var(--font); padding: 0 12px;
    border: 2px solid var(--rule); border-radius: 12px; background: var(--panel); color: var(--fg); }
  button { width: 100%; min-height: 56px; margin-top: 18px; border-radius: 12px; border: 0;
    background: var(--accent); color: #fff; font: 700 22px var(--font); cursor: pointer; }
  .flash { border-left: 6px solid var(--accent); padding: 8px 12px; background: var(--panel); }
  .error { border-left: 6px solid #b91c1c; padding: 8px 12px; background: var(--panel); }
  .hint { color: var(--muted); font-size: 0.8em; margin: 6px 0 0; }
</style>
</head>
<body>
<main>
  {% if not user.needs_password %}<a class="back" href="/">‹ Library</a>{% endif %}
  <h1>Your account</h1>
  <p class="who">{{ user.email }}{% if user.is_admin %} · admin{% endif %}</p>
  {% if flash %}<p class="flash" role="status">{{ flash }}</p>{% endif %}
  {% if error %}<p class="error" role="alert">{{ error }}</p>{% endif %}

  <form method="post" action="/account/password">
    <h2 style="font-size:24px;margin:18px 0 0">{% if user.needs_password %}Choose your password{% else %}Change password{% endif %}</h2>
    {% if not user.needs_password %}
    <label for="current">Current password</label>
    <input id="current" type="password" name="current" autocomplete="current-password" required>
    {% endif %}
    <label for="new">New password</label>
    <input id="new" type="password" name="new" autocomplete="new-password" minlength="{{ min_len }}" required>
    <p class="hint">At least {{ min_len }} characters. A few random words, like "harbour pencil violet gravy", is strong and easy to type.</p>
    <label for="confirm">New password again</label>
    <input id="confirm" type="password" name="confirm" autocomplete="new-password" minlength="{{ min_len }}" required>
    <button type="submit">Save password</button>
  </form>
  {% if user.needs_password %}<p class="hint" style="margin-top:20px"><a href="/logout">Log out</a></p>{% endif %}
</main>
</body>
</html>

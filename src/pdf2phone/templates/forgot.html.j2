<!doctype html>
<html lang="en" data-theme="cream" data-font="dyslexic">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Reader">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<title>Forgot password · Reader</title>
<link rel="stylesheet" href="/{{ static }}/reader.css">
<style>
  main { max-width: 520px; margin: 6vh auto 40px; font-size: 22px; }
  h1 { font-size: 30px; margin: 0 0 16px; }
  label { display: block; margin: 16px 0 8px; }
  input[type=text], input[type=email], input[type=password], textarea { width: 100%; min-height: 56px;
    font: 22px var(--font); padding: 0 12px; border: 2px solid var(--rule); border-radius: 12px;
    background: var(--panel); color: var(--fg); }
  textarea { padding: 10px 12px; min-height: 120px; resize: vertical; }
  button { width: 100%; min-height: 56px; margin-top: 20px; border-radius: 12px; border: 0;
    background: var(--accent); color: #fff; font: 700 22px var(--font); cursor: pointer; }
  .error { border-left: 6px solid #b91c1c; padding: 8px 12px; background: var(--panel); }
  .hint { color: var(--muted); font-size: 0.8em; margin: 6px 0 0; }
  .optional { color: var(--muted); font-weight: 400; }
  .privacy { border: 2px solid var(--rule); border-radius: 14px; padding: 4px 16px; margin-top: 28px;
    background: var(--panel); font-size: 0.85em; }
  .privacy h2 { font-size: 1.1em; margin: 12px 0 4px; }
  /* The trap box for bots: off screen, so people never see or fill it. */
  .trap { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .foot { margin-top: 28px; font-size: 18px; color: var(--muted); }
  .foot a { color: var(--link); }
</style>
</head>
<body>
<main>
{% if state == "form" %}
  <h1>Forgot your password?</h1>
  <p>Type the email address you log in with. If it has an account, we'll email you a link to choose a new password.</p>
  {% if error %}<p class="error" role="alert">{{ error }}</p>{% endif %}
  <form method="post" action="/forgot">
    <input type="hidden" name="stamp" value="{{ stamp }}">
    <div class="trap" aria-hidden="true">
      <label for="website">Leave this empty</label>
      <input id="website" type="text" name="website" tabindex="-1" autocomplete="off">
    </div>
    <label for="email">Email</label>
    <input id="email" type="email" name="email" autocomplete="username" autocapitalize="none"
           spellcheck="false" required autofocus>
    <button type="submit">Email me a link</button>
  </form>

{% elif state == "sent" %}
  <h1>Check your email</h1>
  <p>If that address has an account, we've sent it a link to choose a new password.</p>
  <p>The link works for {{ hours }} hour{{ "s" if hours != 1 }}. If you can't see the email, look in your spam folder.</p>

{% elif state == "choose" %}
  <h1>Choose a new password</h1>
  {% if error %}<p class="error" role="alert">{{ error }}</p>{% endif %}
  <form method="post" action="/reset">
    <input type="hidden" name="t" value="{{ token }}">
    <label for="new">New password</label>
    <input id="new" type="password" name="new" autocomplete="new-password" minlength="{{ min_len }}" required autofocus>
    <p class="hint">At least {{ min_len }} characters. A few random words, like "harbour pencil violet gravy", is strong and easy to type.</p>
    <label for="confirm">New password again</label>
    <input id="confirm" type="password" name="confirm" autocomplete="new-password" minlength="{{ min_len }}" required>
    <button type="submit">Save my new password</button>
  </form>
  <p class="hint">Saving it logs you out on your other devices.</p>

{% elif state == "expired" %}
  <h1>This link doesn't work any more</h1>
  <p>It may have been used already, or it's more than {{ hours }} hour{{ "s" if hours != 1 }} old.</p>
  <p><a href="/forgot">Ask for a new link</a></p>

{% else %}
  <h1>Password reset isn't available</h1>
  <p>Ask the owner to reset your password.</p>
{% endif %}
  <p class="foot"><a href="/login">Log in</a> · <a href="{{ source_url }}">Source code</a></p>
</main>
<script>
try { var s = JSON.parse(localStorage.getItem("pdf2phone:settings") || "null");
  if (s) { document.documentElement.dataset.theme = s.theme || "cream"; document.documentElement.dataset.font = s.font || "dyslexic"; } } catch (e) {}
</script>
</body>
</html>

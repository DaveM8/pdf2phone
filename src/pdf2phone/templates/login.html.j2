<!doctype html>
<html lang="en" data-theme="cream" data-font="dyslexic">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Reader">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<title>Log in · Reader</title>
<link rel="stylesheet" href="/{{ static }}/reader.css">
<style>
  main { max-width: 480px; margin: 12vh auto 0; font-size: 22px; }
  h1 { font-size: 30px; margin: 0 0 16px; }
  label { display: block; margin-bottom: 8px; }
  input[type=password], input[type=email] { width: 100%; min-height: 56px; font: 22px var(--font); padding: 0 12px;
    border: 2px solid var(--rule); border-radius: 12px; background: var(--panel); color: var(--fg); }
  button { width: 100%; min-height: 56px; margin-top: 14px; border-radius: 12px; border: 0;
    background: var(--accent); color: #fff; font: 700 22px var(--font); cursor: pointer; }
  .error { border-left: 6px solid #b91c1c; padding: 8px 12px; background: var(--panel); }
</style>
</head>
<body>
<main>
  <h1>Reading library</h1>
  {% if error %}<p class="error" role="alert">{{ error }}</p>{% endif %}
  <form method="post" action="/login">
    <input type="hidden" name="next" value="{{ next }}">
    <label for="email">Email</label>
    <input id="email" type="email" name="email" value="{{ email }}" autocomplete="username" autocapitalize="none"
           spellcheck="false" {% if not email %}autofocus{% endif %} required>
    <label for="pw" style="margin-top:14px">Password</label>
    <input id="pw" type="password" name="password" autocomplete="current-password" {% if email %}autofocus{% endif %} required>
    <button type="submit">Log in</button>
  </form>
</main>
<script>
try { var s = JSON.parse(localStorage.getItem("pdf2phone:settings") || "null");
  if (s) { document.documentElement.dataset.theme = s.theme || "cream"; document.documentElement.dataset.font = s.font || "dyslexic"; } } catch (e) {}
</script>
</body>
</html>

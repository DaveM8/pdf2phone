<!doctype html>
<html lang="en" data-theme="cream" data-font="dyslexic">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Reader">
<title>Reading library</title>
{% if web %}<link rel="manifest" href="/manifest.webmanifest">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta name="theme-color" content="#fbf5e6">{% endif %}
<link rel="stylesheet" href="{{ static }}/reader.css">
<style>
  .lib { list-style: none; padding: 0; margin: 0; font-size: 22px; }
  .lib li { border-bottom: 2px solid var(--rule); }
  .lib a { display: block; padding: 16px 0; color: var(--fg); text-decoration: none; }
  .lib .t { display: block; font-weight: 700; line-height: 1.3; overflow-wrap: anywhere; }
  .lib .m { display: block; color: var(--muted); font-size: 0.7em; margin-top: 4px; }
  .lib .bar { display: block; height: 6px; background: var(--rule); border-radius: 3px; margin-top: 8px; overflow: hidden; }
  .lib .bar > span { display: block; height: 100%; width: 0; background: var(--accent); }
  h1 { font-size: 28px; margin: 20px 0 8px; }
  .empty { font-size: 22px; color: var(--muted); }
  main { max-width: 900px; margin: 0 auto; }
  .top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; column-gap: 12px; }
  .top h1 { margin-right: auto; }
  .top a { color: var(--link); font-size: 18px; white-space: nowrap; }
  .top .links { font-size: 18px; color: var(--muted); white-space: nowrap; }
  .card { border: 2px solid var(--rule); border-radius: 14px; padding: 14px; margin: 8px 0 18px; background: var(--panel); font-size: 20px; }
  .card label { display: block; margin-bottom: 10px; }
  .big, .card select, .card input[type=file]::file-selector-button {
    min-height: 52px; border-radius: 12px; border: 2px solid var(--rule);
    background: var(--bg); color: var(--fg); font: 700 20px/1 var(--font); padding: 0 14px; }
  .card input[type=file] { font: 18px var(--font); width: 100%; margin-bottom: 12px; color: var(--muted); }
  .card select { width: 100%; margin-bottom: 12px; font-weight: 400; }
  .big { width: 100%; background: var(--accent); border-color: var(--accent); color: #fff; cursor: pointer; }
  .hint { color: var(--muted); font-size: 0.8em; margin: 8px 0 0; }
  .flash { border-left: 6px solid var(--accent); padding: 8px 12px; background: var(--panel); font-size: 20px; margin: 8px 0; }
  .jobs { list-style: none; padding: 0; margin: 0 0 12px; font-size: 18px; }
  .jobs li { padding: 10px 12px; border-radius: 10px; background: var(--panel); border: 2px solid var(--rule); margin-bottom: 8px; }
  .jobs .state { font-weight: 700; }
  .jobs .failed .state { color: #b91c1c; }
  .lib li.has-tools { display: flex; align-items: flex-start; gap: 8px; position: relative; }
  .lib li.has-tools > a { flex: 1; min-width: 0; }
  .tools { padding-top: 14px; }
  .tools summary { list-style: none; cursor: pointer; width: 48px; height: 48px; display: grid; place-items: center;
    border-radius: 10px; border: 2px solid var(--rule); font-size: 22px; }
  .tools summary::-webkit-details-marker { display: none; }
  .tools[open] .menu { display: block; }
  .menu { position: absolute; right: 10px; z-index: 5; background: var(--panel); border: 2px solid var(--rule);
    border-radius: 12px; padding: 10px; font-size: 18px; box-shadow: 0 6px 24px rgba(0,0,0,.2); min-width: 240px; }
  .menu form { margin: 0 0 8px; }
  .menu button, .menu a.btn { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 48px; margin-top: 6px;
    border-radius: 10px; border: 2px solid var(--rule); background: var(--bg); color: var(--fg); font: 700 17px/1.2 var(--font);
    text-decoration: none; cursor: pointer; }
  .menu select { width: 100%; min-height: 46px; font: 17px var(--font); border-radius: 10px; }
  .menu .danger { border-color: #b91c1c; color: #b91c1c; }
</style>
</head>
<body>
<main>
<div class="top"><h1>Reading library</h1>{% if web %}<span class="links">{% if web.user.is_admin %}<a href="/admin">Admin{% if web.waiting %} ({{ web.waiting }} waiting){% endif %}</a> · {% endif %}<a href="/account">Account</a> · <a href="/logout">Log out</a></span>{% endif %}</div>

{% if web %}
{% if web.flash %}<p class="flash">{{ web.flash }}</p>{% endif %}
<form class="card" action="/upload" method="post" enctype="multipart/form-data">
  <label for="pdf"><strong>Add a PDF</strong></label>
  <input id="pdf" type="file" name="pdf" accept="application/pdf,.pdf" required>
  <label for="engine">Converter</label>
  <select id="engine" name="engine">
  {% for e in web.engines %}<option value="{{ e.name }}"{% if e.name == web.default_engine %} selected{% endif %}>{{ e.label }}</option>
  {% endfor %}</select>
  <button class="big" type="submit">Convert</button>
  <p class="hint">Up to {{ web.max_mb }} MB. You can leave this page while it converts.</p>
</form>

{% if web.jobs %}
<ul class="jobs" id="jobs">
{% for j in web.jobs %}<li class="{{ j.state }}"><span class="state">{{ j.state_label }}</span> · {{ j.source_name }} <small>({{ j.engine_label }})</small>{% if j.error %}<br><small>{{ j.error }}</small>{% endif %}</li>
{% endfor %}</ul>
{% endif %}
{% endif %}

{% if docs %}
<ul class="lib">
{% for d in docs %}
  <li{% if web %} class="has-tools"{% endif %}><a href="{{ d.id }}/" data-doc="{{ d.id }}">
    <span class="t">{{ d.title }}</span>
    <span class="m">{{ d.date }} · {{ d.source }}<span class="pct"></span></span>
    <span class="bar"><span></span></span>
  </a>
  {% if web %}<details class="tools"><summary aria-label="Options for {{ d.title }}">⋯</summary>
    <div class="menu">
      <form action="/d/{{ d.id }}/reconvert" method="post">
        <select name="engine" aria-label="Converter">
        {% for e in web.engines %}<option value="{{ e.name }}"{% if e.name == d.engine %} selected{% endif %}>{{ e.label }}</option>
        {% endfor %}</select>
        <button type="submit">Convert again</button>
      </form>
      <a class="btn" href="/d/{{ d.id }}/source.pdf">Original PDF</a>
      <form action="/d/{{ d.id }}/delete" method="post" onsubmit="return confirm('Delete this document?')">
        <button type="submit" class="danger">Delete</button>
      </form>
    </div>
  </details>{% endif %}</li>
{% endfor %}
</ul>
{% elif web %}
<p class="empty">Nothing here yet. Choose a PDF above.</p>
{% else %}
<p class="empty">Nothing here yet. Run <code>pdf2phone convert some.pdf</code> on the Mac.</p>
{% endif %}
{% if web %}<p class="hint" style="margin-top:28px"><a href="{{ web.source_url }}">Source code</a></p>{% endif %}
</main>
<script>
(function () {
  try {
    var s = JSON.parse(localStorage.getItem("pdf2phone:settings") || "null");
    if (s) {
      document.documentElement.setAttribute("data-theme", s.theme || "cream");
      document.documentElement.setAttribute("data-font", s.font || "dyslexic");
    }
    document.querySelectorAll("[data-doc]").forEach(function (a) {
      var p = JSON.parse(localStorage.getItem("pdf2phone:pos:" + a.getAttribute("data-doc")) || "null");
      if (p && typeof p.pct === "number") {
        var pct = Math.round(p.pct * 100);
        a.querySelector(".bar > span").style.width = pct + "%";
        a.querySelector(".pct").textContent = " · " + pct + "% read";
      }
    });
  } catch (e) {}
{% if web and web.busy %}
  // A conversion is running: check every 2s and reload when it's done.
  var poll = setInterval(function () {
    fetch("/api/jobs", { credentials: "same-origin" }).then(function (r) { return r.json(); }).then(function (d) {
      if (!d.busy) { clearInterval(poll); location.replace("/"); }
    }).catch(function () {});
  }, 2000);
{% endif %}
})();
</script>
</body>
</html>
